<h1 class="page-title">Notificaciones</h1>

<% if (list.length) { %>
  <div class="notifs">
    <% for (const n of list) { %>
      <article class="notif<%= n.read_at ? '' : ' notif-new' %>">
        <% const art = { nivel: expresion('feliz'), tarjeta_completa: ilus.taza, evento: factura(1), cumpleanos: ilus.torta, te_extranamos: expresion('triste') }[n.type] || expresion('contenta'); %>
        <span class="notif-art"><img class="ilus" src="<%= art %>" alt=""></span>
        <div>
          <strong><%= n.title %></strong>
          <% if (n.body) { %><p><%= n.body %></p><% } %>
          <span class="muted small"><%= time.relativeDay(n.created_at) %></span>
        </div>
      </article>
    <% } %>
  </div>
<% } else { %>
  <div class="empty">
    <span class="empty-art empty-marta"><%- martaCara('dormida') %></span>
    <p>Todavía no tenés notificaciones.</p>
  </div>
<% } %>
