<h1 class="page-title">Eventos</h1>

<% if (list.length) { %>
  <div class="events">
    <% for (const e of list) { %>
      <article class="card event" id="evento-<%= e.id %>">
        <div class="event-date">
          <span><%= time.fmtDateTime(e.starts_at) %></span>
        </div>
        <h2><%= e.name %></h2>
        <% if (e.description) { %><p class="muted"><%= e.description %></p><% } %>

        <div class="event-status">
          <% if (e.mine) { %>
            <span class="pill pill-solid">Reservaste <%= e.mine.seats %> lugar<%= e.mine.seats > 1 ? 'es' : '' %></span>
          <% } else if (e.phase === 'lleno') { %>
            <span class="pill pill-muted">Sin lugares</span>
          <% } else if (e.phase === 'pronto') { %>
            <span class="pill pill-muted">Reservas desde el <%= time.fmtDateTime(e.booking_opens_at) %></span>
          <% } else if (e.phase === 'prioridad') { %>
            <span class="pill pill-marta"><img src="<%= expresion('feliz') %>" alt="">Prioridad <%= e.topLevelName %></span>
          <% } %>
          <% if (e.phase !== 'pronto') { %>
            <span class="muted small"><%= e.left %> lugar<%= e.left === 1 ? '' : 'es' %> disponible<%= e.left === 1 ? '' : 's' %></span>
          <% } %>
        </div>

        <% if (e.phase === 'prioridad' && !e.isTop && !e.mine) { %>
          <p class="hint">Hasta el <%= time.fmtDateTime(e.publicAt) %> reservan solo los clientes <%= e.topLevelName %>. Después se abre a todos.</p>
        <% } %>

        <% if (e.mine) { %>
          <form method="post" action="/reservas/<%= e.mine.id %>/cancelar" data-confirm="¿Cancelar tu reserva para «<%= e.name %>»?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="link-btn" type="submit">Cancelar reserva</button>
          </form>
        <% } else if (e.canBook) { %>
          <form class="reserve" method="post" action="/eventos/<%= e.id %>/reservar">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label class="field field-inline">
              <span>Lugares</span>
              <select name="seats">
                <% for (let i = 1; i <= e.maxSeatsNow; i++) { %><option value="<%= i %>"><%= i %></option><% } %>
              </select>
            </label>
            <button class="btn" type="submit">Reservar</button>
          </form>
        <% } %>
      </article>
    <% } %>
  </div>
<% } else { %>
  <div class="empty">
    <span class="empty-art empty-marta"><%- martaCara('dormida') %></span>
    <p>Por ahora no hay eventos programados.<br>Te vamos a avisar cuando haya uno nuevo.</p>
  </div>
<% } %>

<% if (past.length) { %>
<section class="section">
  <h2>Eventos a los que fuiste</h2>
  <div class="list">
    <% for (const r of past) { %>
      <div class="row"><span><strong><%= r.name %></strong><span class="muted small"><%= time.fmtDate(r.starts_at) %></span></span><span class="muted small"><%= r.seats %> lugar<%= r.seats > 1 ? 'es' : '' %></span></div>
    <% } %>
  </div>
</section>
<% } %>
