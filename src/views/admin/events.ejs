<%
  const PHASE = { pronto: 'Todavía no abre', prioridad: 'Prioridad', abierto: 'Abierto', lleno: 'Completo', inactivo: 'Oculto', pasado: 'Finalizado' };
%>
<div class="page-head">
  <h1 class="page-title">Eventos</h1>
  <a class="btn btn-small" href="/admin/eventos/nuevo">Nuevo evento</a>
</div>

<% if (upcoming.length) { %>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Evento</th><th>Fecha</th><th>Reservas</th><th>Estado</th></tr></thead>
      <tbody>
        <% for (const e of upcoming) { %>
          <tr data-href="/admin/eventos/<%= e.id %>">
            <td><a href="/admin/eventos/<%= e.id %>"><strong><%= e.name %></strong></a></td>
            <td><%= time.fmtDateTime(e.starts_at) %></td>
            <td>
              <div class="mini-bar"><span style="width:<%= Math.min(100, Math.round(e.taken / e.capacity * 100)) %>%"></span></div>
              <span class="small"><%= e.taken %> / <%= e.capacity %></span>
            </td>
            <td><span class="pill pill-xs<%= e.phase === 'abierto' || e.phase === 'prioridad' ? ' pill-solid' : '' %>"><%= PHASE[e.phase] %><%= e.phase === 'prioridad' ? ' ' + e.topLevelName : '' %></span></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
<% } else { %>
  <div class="empty">
    <%- include('../partials/art', { key: 1, cls: 'empty-art' }) %>
    <p>No hay eventos próximos.</p>
    <a class="btn" href="/admin/eventos/nuevo">Crear evento</a>
  </div>
<% } %>

<% if (past.length) { %>
  <section class="section">
    <h2>Pasados</h2>
    <div class="list list-plain">
      <% for (const e of past) { %>
        <a class="row-link" href="/admin/eventos/<%= e.id %>">
          <span><strong><%= e.name %></strong><span class="muted small"><%= time.fmtDate(e.starts_at) %></span></span>
          <span class="muted small"><%= e.taken %> / <%= e.capacity %></span>
        </a>
      <% } %>
    </div>
  </section>
<% } %>
