<h1 class="page-title">Niveles</h1>
<p class="muted">El nivel se calcula por las visitas totales históricas (no se reinicia con la tarjeta). El nivel más alto tiene prioridad para reservar en eventos.</p>

<div class="levels">
  <% for (const l of list) { %>
    <form class="card form level" method="post" action="/admin/niveles/<%= l.id %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="card-head">
        <h2><%= l.name %></h2>
        <span class="muted small"><%= counts[l.id] || 0 %> cliente<%= counts[l.id] === 1 ? '' : 's' %></span>
      </div>
      <div class="row-2">
        <label class="field"><span>Nombre</span><input name="name" value="<%= l.name %>" required></label>
        <label class="field"><span>Desde (visitas totales)</span><input name="min_visits" type="number" min="0" value="<%= l.min_visits %>" inputmode="numeric" required<%= l.min_visits === 0 ? ' readonly' : '' %>></label>
      </div>
      <label class="field"><span>Ventajas del nivel</span><textarea name="perks" rows="2"><%= l.perks %></textarea></label>
      <% const lt = tpls.filter((t) => t.level_id === l.id); %>
      <p class="hint">Regalo al alcanzarlo:
        <% if (lt.length) { %><% lt.forEach((t, i) => { %><a href="/admin/beneficios/<%= t.id %>"><%= t.name %></a><%= t.active ? '' : ' (inactivo)' %><%= i < lt.length - 1 ? ', ' : '' %><% }) %>
        <% } else { %>ninguno.<% } %>
        <a href="/admin/beneficios/nuevo">Agregar</a>
      </p>
      <div class="actions-row">
        <button class="btn btn-small" type="submit">Guardar</button>
        <% if (l.min_visits !== 0) { %>
          <button class="btn btn-small btn-danger" type="submit" formaction="/admin/niveles/<%= l.id %>/eliminar" data-confirm="¿Eliminar <%= l.name %>? Sus clientes pasan al nivel que les corresponda.">Eliminar</button>
        <% } %>
      </div>
    </form>
  <% } %>
</div>

<form class="card form card-soft" method="post" action="/admin/niveles">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <h2>Nuevo nivel</h2>
  <div class="row-2">
    <label class="field"><span>Nombre</span><input name="name" placeholder="Marta 4" required></label>
    <label class="field"><span>Desde (visitas totales)</span><input name="min_visits" type="number" min="1" inputmode="numeric" required></label>
  </div>
  <label class="field"><span>Ventajas del nivel</span><textarea name="perks" rows="2"></textarea></label>
  <button class="btn btn-small" type="submit">Crear nivel</button>
</form>
