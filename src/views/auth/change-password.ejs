<section class="welcome welcome-small">
  <h1>Creá tu nueva contraseña</h1>
  <p class="muted">Entraste con una contraseña temporal. Elegí una nueva para seguir.</p>
</section>

<form class="card form" method="post" action="/cambiar-clave" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <label class="field<%= errors.password ? ' invalid' : '' %>">
    <span>Nueva contraseña</span>
    <input name="password" type="password" autocomplete="new-password" minlength="6" required autofocus>
    <% if (errors.password) { %><small class="field-error"><%= errors.password %></small><% } %>
  </label>
  <label class="field<%= errors.password2 ? ' invalid' : '' %>">
    <span>Repetí la contraseña</span>
    <input name="password2" type="password" autocomplete="new-password" required>
    <% if (errors.password2) { %><small class="field-error"><%= errors.password2 %></small><% } %>
  </label>
  <button class="btn btn-block" type="submit">Guardar y seguir</button>
</form>

<form class="center" method="post" action="/salir">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <button class="link-btn" type="submit">Salir</button>
</form>
