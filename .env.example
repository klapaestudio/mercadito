# Puerto HTTP (Railway lo define solo)
PORT=3000

# development | production  (en production la cookie de sesión es "secure" y requiere HTTPS)
NODE_ENV=development

# Carpeta donde se guardan la base SQLite y las sesiones.
# En Railway apuntala al volumen montado, por ejemplo /data
DATA_DIR=./data

# Secreto para firmar la cookie de sesión. Usá un texto largo y aleatorio.
SESSION_SECRET=cambiame-por-un-texto-largo-y-aleatorio

# Admin inicial: se crea solo la primera vez, si no existe ningún admin.
ADMIN_USER=admin
ADMIN_PASSWORD=cambiame123

# Zona horaria para "1 sello por día", cumpleaños y tareas automáticas
TZ_APP=America/Argentina/Buenos_Aires
